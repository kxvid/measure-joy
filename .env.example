# Copy to .env.local and populate privately. Never commit real credentials.
# Vercel scopes: configure Production separately from Preview/Development.
# Use test services and credentials for local development and previews.

# Application origin: local here; https://www.measurejoy.org in Production.
# Preview must use its own stable preview origin, not the production origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk: both values must belong to the same Clerk instance/environment.
# NEXT_PUBLIC_ values are exposed to the browser; use only publishable keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated email addresses authorized for the existing admin console.
ADMIN_EMAILS=owner@example.com

# Stripe: server-only. Use test-mode keys locally and in Preview.
STRIPE_SECRET_KEY=
# Signing secret for this environment's /api/stripe/webhook endpoint.
# This is distinct from STRIPE_SECRET_KEY and must be configured separately.
STRIPE_WEBHOOK_SECRET=

# Supabase: public project URL/anon key plus server-only service role.
# Use a separate nonproduction project or branch for Preview/Development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact/repair: FormSubmit needs email activation; no API key or DNS setup.
# Resend: still required for newsletter/review notifications and transactional email.
RESEND_API_KEY=
# Optional newsletter/review sender override; must use a verified Resend sender/domain.
# Blank uses the existing Measure Joy <orders@measurejoy.org> default.
RESEND_FROM_EMAIL=

# Optional: existing admin AI copywriter/categorizer features only.
GOOGLE_AI_API_KEY=

# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_ENV and NODE_ENV are
# platform/framework supplied. Do not paste tokens into this file.
# See docs/vercel-readiness.md for the verified Vercel variable inventory.
